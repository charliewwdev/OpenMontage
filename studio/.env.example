# Drama Studio — local Docker defaults (one-shot friendly)
#   cp studio/.env.example .env
#   docker compose -f docker-compose.studio.yml up --build
# Open http://localhost:8787 → click Demo.
# Hosted / Coolify: override STUDIO_PUBLIC_URL, API_BASE_URL, MINIO_* in the panel.
# Full guide: docs/SELF_HOSTING.md

# --- Listen (Coolify injects PORT) ---
HOST=0.0.0.0
PORT=8787

# --- Paths ---
OPENMONTAGE_ROOT=/app
PROJECTS_ROOT=/data/projects
STUDIO_DIST=/app/studio/dist

# --- Postgres (Compose service drama-db) ---
POSTGRES_USER=omstudio
POSTGRES_PASSWORD=omstudio_change_me
POSTGRES_DB=omstudio
# Leave empty to use Compose default:
# postgresql://omstudio:omstudio_change_me@drama-db:5432/omstudio?sslmode=disable
DATABASE_URL=
# STUDIO_DATABASE_URL=

# --- Public URL / auth (local Demo — no external account API) ---
STUDIO_PUBLIC_URL=http://localhost:8787
STUDIO_CORS_ORIGINS=http://localhost:8787
STUDIO_AUTH_REQUIRED=true
STUDIO_DEMO_ENABLED=true
STUDIO_DEMO_AUTO_ENTER=false
STUDIO_GOOGLE_ENABLED=false
# Optional HMAC secret for demo tokens (set a strong secret in production)
# STUDIO_DEMO_SECRET=
# STUDIO_OPS_TOKEN=
# Password / register / Google proxy here. Leave empty for Demo-only local setups.
API_BASE_URL=
# Hosted example (Coolify):
# STUDIO_PUBLIC_URL=https://openmontage.dtok.io
# API_BASE_URL=https://api-app.dtok.io/api/v1
# STUDIO_GOOGLE_ENABLED=true
# STUDIO_GOOGLE_CLIENT_ID=...

# --- Dev only (Vite) ---
STUDIO_API_PORT=8787
STUDIO_UI_PORT=5173

# --- Object storage (Compose starts drama-minio + creates bucket) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://drama-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=openmontage
MINIO_PREFIX=openmontage
MINIO_PUBLIC_BASE=http://127.0.0.1:9000
# Hosted MinIO / S3 override example:
# MINIO_ENDPOINT=https://minio-api.example.com
# OSS_API_BASE_URL=https://minio-api.example.com
# OSS_CONSOLE_USERNAME=
# OSS_CONSOLE_PASSWORD=

# --- Generation keys (optional for boot; required for full workflow) ---
# Add in UI「模型配置」or here. Compose starts without them.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# LLM_PROVIDER=gpuhome
GPUHOME_API_KEY=
GPUHOME_BASE_URL=https://tokens.gpuhome.cc/v1
GPUHOME_MODEL=deepseek-v4-flash
# LLM_PROVIDER=suanqiao
# SUANQIAO_API_KEY=
# SUANQIAO_BASE_URL=https://api.suanjiayun.com/v1
# SUANQIAO_MODEL=qwen3.6-plus
# LLM_PROVIDER=cloudgpu
# CLOUDGPU_API_KEY=
# CLOUDGPU_BASE_URL=https://cloudgpu.app/v1
# CLOUDGPU_MODEL=deepseek-v4-flash
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com
CURSOR_MODEL=auto
VOLCENGINE_API_KEY=
ARK_API_KEY=
SEEDREAM_MODEL=
SEEDANCE_MODEL=
# COMFYUI_SERVER_URL=https://xxx.gpuhome.cc
# COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
NVIDIA_API_KEY=
NVIDIA_NIM_API_KEY=

# --- Optional media / gen keys ---
FAL_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
DASHSCOPE_API_KEY=
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
REPLICATE_API_TOKEN=
KLING_API_KEY=
HEYGEN_API_KEY=
