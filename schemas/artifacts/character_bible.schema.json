{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/character_bible",
  "title": "Character Bible",
  "description": "Cross-episode identity pack for short-drama characters, locations, props, and voices.",
  "type": "object",
  "required": ["version", "characters"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "visual_style": { "type": "string" },
    "palette": {
      "type": "array",
      "items": { "type": "string" }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "display_name", "role", "appearance"],
        "properties": {
          "id": { "type": "string" },
          "display_name": { "type": "string" },
          "role": { "type": "string" },
          "appearance": { "type": "string" },
          "wardrobe_variants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "description": { "type": "string" },
                "reference_images": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          },
          "reference_images": {
            "type": "array",
            "items": { "type": "string" }
          },
          "provider_subject_ids": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Provider-specific identity locks (e.g. higgsfield soul id)"
          },
          "voice": {
            "type": "object",
            "properties": {
              "tts_provider": { "type": "string" },
              "voice_id": { "type": "string" },
              "style_notes": { "type": "string" }
            },
            "additionalProperties": false
          },
          "consistency_notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reference_images": {
            "type": "array",
            "items": { "type": "string" }
          },
          "time_of_day": { "type": "string" },
          "mood": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "reference_images": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "store_path": {
      "type": "string",
      "description": "Project-relative path to bible media store (e.g. bible/)"
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
