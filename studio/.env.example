# Drama Studio — Coolify / local runtime
# Pattern aligned with dtok-app public API host style + OpenMontage provider keys.

# --- Listen (Coolify injects PORT) ---
HOST=0.0.0.0
PORT=8787

# --- Paths ---
OPENMONTAGE_ROOT=/app
PROJECTS_ROOT=/data/projects
STUDIO_DIST=/app/studio/dist

# --- Public URLs (dtok-style) ---
# Public URL (aaPanel reverse proxy → container :8787)
STUDIO_PUBLIC_URL=https://openmontage.dtok.io
# Optional upstream API (same shape as dtok-app AppConstants.apiBaseUrl)
API_BASE_URL=https://api-app.dtok.io/api/v1
# Require DTok login/register before using the studio UI (default true)
STUDIO_AUTH_REQUIRED=true
# Public one-click Demo user (default true). Set false to hide Demo entry.
STUDIO_DEMO_ENABLED=true
# Auto-enter Demo on first visit (default true). Logout skips until next demo click.
STUDIO_DEMO_AUTO_ENTER=true
# Optional HMAC secret for demo tokens (defaults to a local demo secret)
# STUDIO_DEMO_SECRET=
# Google Sign-In (GIS) web client id — defaults to DTok Firebase web OAuth client
# STUDIO_GOOGLE_CLIENT_ID=165025931859-umal625a9njtveircsijfcr6d1v5s2dk.apps.googleusercontent.com
# STUDIO_GOOGLE_ENABLED=true

# --- Dev only (Vite) ---
STUDIO_API_PORT=8787
STUDIO_UI_PORT=5173

# --- Platform config (lists / copy / model catalog) ---
# Default: studio/config/platform.yaml inside the image
# STUDIO_PLATFORM_CONFIG=/app/studio/config/platform.yaml
# Optional overrides (else read from platform.yaml defaults):
# STUDIO_DEFAULT_GENRE=
# STUDIO_DEFAULT_RATIO=
# STUDIO_DEFAULT_VISUAL_STYLE=
# SEEDANCE_API_URL=

# --- Xuefeng-parity generation (required for full workflow) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
# Volcengine Ark — Seedream images + Seedance video (ARK_API_KEY is an alias)
VOLCENGINE_API_KEY=
ARK_API_KEY=
SEEDREAM_MODEL=
SEEDANCE_MODEL=

# --- Optional media / gen keys (pass through from Coolify secrets) ---
FAL_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
DASHSCOPE_API_KEY=
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
REPLICATE_API_TOKEN=
KLING_API_KEY=
HEYGEN_API_KEY=
