# Drama Studio — Coolify / local runtime
# Pattern aligned with dtok-app public API host style + OpenMontage provider keys.

# --- Listen (Coolify injects PORT) ---
HOST=0.0.0.0
PORT=8787

# --- Paths ---
OPENMONTAGE_ROOT=/app
PROJECTS_ROOT=/data/projects
STUDIO_DIST=/app/studio/dist

# --- Postgres (project/secrets dual-write; survives Coolify volume wipe) ---
# Prefer same-compose service `drama-db` (see docker-compose.studio.yml).
# DATABASE_URL=postgresql://omstudio:PASSWORD@drama-db:5432/omstudio?sslmode=disable
# STUDIO_DATABASE_URL overrides DATABASE_URL when both are set.
POSTGRES_USER=omstudio
POSTGRES_PASSWORD=
POSTGRES_DB=omstudio
DATABASE_URL=
# STUDIO_DATABASE_URL=

# --- Public URLs (dtok-style) ---
# Public URL (aaPanel reverse proxy → container :8787)
STUDIO_PUBLIC_URL=https://openmontage.dtok.io
# Optional upstream API (same shape as dtok-app AppConstants.apiBaseUrl)
API_BASE_URL=https://api-app.dtok.io/api/v1
# Require DTok login/register before using the studio UI (default true)
STUDIO_AUTH_REQUIRED=true
# Public one-click Demo user (default true). Set false to hide Demo entry.
STUDIO_DEMO_ENABLED=true
# Auto-enter Demo on first visit — keep false for product soft-launch.
STUDIO_DEMO_AUTO_ENTER=false
# Optional HMAC secret for demo tokens (set a strong secret in production)
# STUDIO_DEMO_SECRET=
# Ops bootstrap token for scripts/restore_studio_keys.sh (defaults to STUDIO_DEMO_SECRET)
# STUDIO_OPS_TOKEN=
# Comma-separated browser origins (defaults to STUDIO_PUBLIC_URL)
# STUDIO_CORS_ORIGINS=https://openmontage.dtok.io
# Google Sign-In (GIS) web client id — defaults to DTok Firebase web OAuth client
# STUDIO_GOOGLE_CLIENT_ID=165025931859-umal625a9njtveircsijfcr6d1v5s2dk.apps.googleusercontent.com
# STUDIO_GOOGLE_ENABLED=true

# --- Dev only (Vite) ---
STUDIO_API_PORT=8787
STUDIO_UI_PORT=5173

# --- Platform config (lists / copy / model catalog) ---
# Default: studio/config/platform.yaml inside the image
# STUDIO_PLATFORM_CONFIG=/app/studio/config/platform.yaml
# Optional overrides (else read from platform.yaml defaults):
# STUDIO_DEFAULT_GENRE=
# STUDIO_DEFAULT_RATIO=
# STUDIO_DEFAULT_VISUAL_STYLE=
# SEEDANCE_API_URL=

# --- Xuefeng-parity generation (required for full workflow) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
# 智川云 Token 工厂（OpenAI 兼容；余额需从 gpuhome.cc 转到 Token 工厂）
# LLM_PROVIDER=gpuhome
GPUHOME_API_KEY=
GPUHOME_BASE_URL=https://tokens.gpuhome.cc/v1
# 可选: deepseek-v4-flash | deepseek-v4-pro | qwen3.8-max | glm-5.3 | kimi-k3 | minimax-m3 | ...
GPUHOME_MODEL=deepseek-v4-flash

# 算桥 / 算家云（OpenAI 兼容；控制台 https://suanjiayun.com/apiUser/）
# 令牌按「单位+项目」隔离。Chat: POST https://api.suanjiayun.com/v1/chat/completions
# LLM_PROVIDER=suanqiao
# SUANQIAO_API_KEY=
# SUANQIAO_BASE_URL=https://api.suanjiayun.com/v1
# SUANQIAO_MODEL=qwen3.6-plus
# Cursor Cloud Agents — Auto text/script when DeepSeek is absent (crsr_… key)
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com
CURSOR_MODEL=auto
# Volcengine Ark — Seedream images + Seedance video (ARK_API_KEY is an alias)
VOLCENGINE_API_KEY=
ARK_API_KEY=
SEEDREAM_MODEL=
SEEDANCE_MODEL=
# Optional: ComfyUI on a rented GPU (gpuhome.cc/market → ComfyUI 镜像 → 开放端口)
# 出图优先走 ComfyUI；未配置时回退火山 Seedream。视频仍用 Seedance。
# COMFYUI_SERVER_URL=https://xxx.gpuhome.cc
# COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# COMFYUI_IMAGE_SERVER_URL=
# COMFYUI_VIDEO_SERVER_URL=

# --- Object storage (same OSS_* names as dtok-app; MinIO) ---
# Binary media + inspire images. Postgres keeps metadata / fallback.
OSS_API_BASE_URL=https://minio-api.dtok.io
OSS_CONSOLE_USERNAME=
OSS_CONSOLE_PASSWORD=
# Optional aliases:
# MINIO_ENDPOINT=https://minio-api.dtok.io
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
MINIO_BUCKET=dtok-app
MINIO_PREFIX=openmontage

# --- Optional media / gen keys (pass through from Coolify secrets) ---
FAL_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
DASHSCOPE_API_KEY=
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=
REPLICATE_API_TOKEN=
KLING_API_KEY=
HEYGEN_API_KEY=
