{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI drama video prompt",
  "type": "object",
  "required": [
    "id",
    "title",
    "prompt_zh",
    "prompt_en",
    "model",
    "category",
    "stage",
    "tags",
    "source",
    "license",
    "attribution"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "prompt_zh": {
      "type": "string"
    },
    "prompt_en": {
      "type": "string"
    },
    "model": {
      "enum": [
        "Hailuo",
        "Kling",
        "Seedance",
        "Sora",
        "Veo",
        "generic"
      ]
    },
    "category": {
      "enum": [
        "actions",
        "genres",
        "hooks",
        "camera",
        "lighting",
        "character",
        "storyboard",
        "ecommerce",
        "platform",
        "sound",
        "negative"
      ]
    },
    "subcategory": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "enum": [
        "character",
        "edit",
        "prop",
        "scene",
        "script",
        "storyboard",
        "voice"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preview": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional URL to a preview hosted by the rights holder or generated by OpenMontage. Never rehost third-party media."
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "license": {
      "enum": [
        "Apache-2.0",
        "CC-BY-4.0",
        "CC0-1.0",
        "MIT"
      ]
    },
    "license_url": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "lang_origin": {
      "enum": [
        "zh",
        "en"
      ]
    },
    "translated": {
      "enum": [
        "none",
        "human",
        "machine"
      ]
    },
    "modified": {
      "type": "boolean"
    }
  }
}
