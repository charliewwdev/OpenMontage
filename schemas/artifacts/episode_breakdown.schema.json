{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/episode_breakdown",
  "title": "Episode Breakdown",
  "description": "Series and episode tree with dramatic scenes for short-drama production.",
  "type": "object",
  "required": ["version", "series_title", "episodes"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "series_title": { "type": "string" },
    "aspect_ratio": {
      "type": "string",
      "enum": ["9:16", "16:9", "1:1", "4:5"],
      "default": "9:16"
    },
    "target_episode_duration_seconds": { "type": "number", "minimum": 1 },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "scenes"],
        "properties": {
          "id": { "type": "string" },
          "index": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "logline": { "type": "string" },
          "hook": { "type": "string" },
          "cliffhanger": { "type": "string" },
          "target_duration_seconds": { "type": "number", "minimum": 1 },
          "scenes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "purpose"],
              "properties": {
                "id": { "type": "string" },
                "index": { "type": "integer", "minimum": 1 },
                "title": { "type": "string" },
                "location_id": { "type": "string" },
                "purpose": { "type": "string" },
                "emotional_beat": { "type": "string" },
                "characters": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "estimated_duration_seconds": { "type": "number", "minimum": 1 },
                "notes": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "active_episode_id": {
      "type": "string",
      "description": "Episode to produce first; default first episode when omitted"
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
